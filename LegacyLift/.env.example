# ==============================================================================
# LegacyLift Configuration Template
# Copy this file to .env to configure your local or production cloud settings
# ==============================================================================

# Platform Execution Mode: SIMULATION or LIVE
LEGACYLIFT_MODE=SIMULATION

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=acme-analytics-prod
GCP_DEFAULT_DATASET=legacy_dw
GCP_LOCATION=US
GCS_BUCKET=gs://legacylift-iceberg-prod-us
ICEBERG_CATALOG=legacylift_iceberg_catalog
DATAPROC_CLUSTER=legacylift-spark-cluster
DATAPROC_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account-key.json

# ------------------------------------------------------------------------------
# Snowflake Configuration
# ------------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=MIGRATION_ADMIN
SNOWFLAKE_PASSWORD=your_snowflake_password_here
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS_DW
SNOWFLAKE_SCHEMA=HISTORICAL
SNOWFLAKE_STORAGE_INTEGRATION=GCS_LEGACYLIFT_STORAGE_INT
SNOWFLAKE_EXTERNAL_VOLUME=EXVOL_LEGACYLIFT_ICEBERG
SNOWFLAKE_CATALOG_INTEGRATION=CATALOG_LEGACYLIFT_GCS

# ------------------------------------------------------------------------------
# Batch Processing & Execution Tuning
# ------------------------------------------------------------------------------
DEFAULT_BATCH_SIZE=500000
MAX_CONCURRENCY=3
RETRY_LIMIT=3
RETRY_BACKOFF_BASE=1.0
TIMEOUT_SECONDS=3600
VALIDATE_ROW_COUNTS=true
VALIDATE_CHECKSUMS=true
